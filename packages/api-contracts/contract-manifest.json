      "httpStatus": 409,
      "defaultMessage": "MCP 工具名称发生冲突"
    },
    "CHAT_CONTEXT_LIMIT_REACHED": {
      "code": "CHAT_CONTEXT_LIMIT_REACHED",
      "category": "business",
      "httpStatus": 409,
      "defaultMessage": "会话上下文已达到安全上限，请先手动压缩记忆"
    },
    "VALIDATION_REQUEST_INVALID": {
      "code": "VALIDATION_REQUEST_INVALID",
      "category": "validation",
      "httpStatus": 422,
      "defaultMessage": "请求参数验证失败"
    },
    "SYSTEM_ROUTE_NOT_FOUND": {
      "code": "SYSTEM_ROUTE_NOT_FOUND",
      "category": "system",
      "httpStatus": 404,
      "defaultMessage": "请求的资源不存在"
    },
    "SYSTEM_METHOD_NOT_ALLOWED": {
      "code": "SYSTEM_METHOD_NOT_ALLOWED",
      "category": "system",
      "httpStatus": 405,
      "defaultMessage": "请求方法不受支持"
    },
    "SYSTEM_INTERNAL_ERROR": {
      "code": "SYSTEM_INTERNAL_ERROR",
      "category": "system",
      "httpStatus": 500,
      "defaultMessage": "服务暂时不可用"
    },
    "SYSTEM_MODEL_CAPABILITY_MISSING": {
      "code": "SYSTEM_MODEL_CAPABILITY_MISSING",
      "category": "system",
      "httpStatus": 500,
      "defaultMessage": "当前模型缺少上下文窗口配置"
    },
    "SYSTEM_MCP_CONNECTION_FAILED": {
      "code": "SYSTEM_MCP_CONNECTION_FAILED",
      "category": "system",
      "httpStatus": 502,
      "defaultMessage": "MCP Server 连接失败"
    },
    "SYSTEM_ALERT_SOURCES_UNAVAILABLE": {
      "code": "SYSTEM_ALERT_SOURCES_UNAVAILABLE",
      "category": "system",
      "httpStatus": 503,
      "defaultMessage": "活跃告警来源暂时不可用"
    }
