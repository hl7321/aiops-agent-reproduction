{
  "schemaVersion": 1,
  "errors": {
    "AUTH_REQUIRED": {
      "code": "AUTH_REQUIRED",
      "category": "authentication",
      "httpStatus": 401,
      "defaultMessage": "需要认证后才能访问"
    },
    "AUTH_FORBIDDEN": {
      "code": "AUTH_FORBIDDEN",
      "category": "authorization",
      "httpStatus": 403,
      "defaultMessage": "没有权限执行该操作"
    },
    "AUTH_INVALID_CREDENTIALS": {
      "code": "AUTH_INVALID_CREDENTIALS",
      "category": "authentication",
      "httpStatus": 401,
      "defaultMessage": "邮箱或密码错误"
    },
    "AUTH_EMAIL_ALREADY_REGISTERED": {
      "code": "AUTH_EMAIL_ALREADY_REGISTERED",
      "category": "business",
      "httpStatus": 409,
      "defaultMessage": "该邮箱已注册"
    },
    "BUSINESS_RULE_VIOLATION": {
      "code": "BUSINESS_RULE_VIOLATION",
      "category": "business",
      "httpStatus": 409,
      "defaultMessage": "请求与当前业务规则冲突"
    },
    "BUSINESS_CONFLICT": {
      "code": "BUSINESS_CONFLICT",
      "category": "business",
      "httpStatus": 409,
      "defaultMessage": "相同内容的文档已存在"
    },
    "BUSINESS_RESOURCE_NOT_FOUND": {
      "code": "BUSINESS_RESOURCE_NOT_FOUND",
      "category": "business",
      "httpStatus": 404,
      "defaultMessage": "请求的资源不存在"
    },
    "VALIDATION_REQUEST_INVALID": {
      "code": "VALIDATION_REQUEST_INVALID",
      "category": "validation",
      "httpStatus": 422,
      "defaultMessage": "请求参数验证失败"
    },
    "SYSTEM_ROUTE_NOT_FOUND": {
      "code": "SYSTEM_ROUTE_NOT_FOUND",
      "category": "system",
      "httpStatus": 404,
      "defaultMessage": "请求的资源不存在"
    },
    "SYSTEM_METHOD_NOT_ALLOWED": {
      "code": "SYSTEM_METHOD_NOT_ALLOWED",
      "category": "system",
      "httpStatus": 405,
      "defaultMessage": "请求方法不受支持"
    },
    "SYSTEM_INTERNAL_ERROR": {
      "code": "SYSTEM_INTERNAL_ERROR",
      "category": "system",
      "httpStatus": 500,
      "defaultMessage": "服务暂时不可用"
    }
  },
  "openapi": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "protectedPathPolicy": {
      "security": "BearerAuth",
      "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN"]
    },
    "paths": {
      "/health": {
        "method": "GET",
        "operationId": "getHealth",
        "successData": "FoundationStatus"
      },
      "/auth/register": {
        "method": "POST",
        "operationId": "registerUser",
        "successData": "AuthUser"
      },
      "/auth/login": {
        "method": "POST",
        "operationId": "loginUser",
        "successData": "LoginData"
      },
      "/auth/logout": {
        "method": "POST",
        "operationId": "logoutUser",
        "successData": "LogoutData",
        "security": ["BearerAuth"],
        "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN"]
      },
      "/auth/me": {
        "method": "GET",
        "operationId": "getCurrentUser",
        "successData": "AuthUser",
        "security": ["BearerAuth"],
        "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN"]
      },
      "/chat/sessions": {
        "method": "POST",
        "operationId": "createChatSession",
        "successData": "ChatSessionDetailData",
        "security": ["BearerAuth"],
        "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN"]
      },
      "/chat/sessions/{id}": {
        "method": "GET",
        "operationId": "getChatSession",
        "successData": "ChatSessionDetailData",
        "security": ["BearerAuth"],
        "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN"]
      },
      "/chat/sessions/{id}/messages": {
        "method": "POST",
        "operationId": "appendChatMessage",
        "successData": "ChatSessionDetailData",
        "security": ["BearerAuth"],
        "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN", "VALIDATION_REQUEST_INVALID"]
      },
      "/chat/sessions/{id}/messages:clear": {
        "method": "POST",
        "operationId": "clearChatMessages",
        "successData": "ChatSessionDetailData",
        "security": ["BearerAuth"],
        "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN"]
      },
      "/background-jobs": {
        "method": "GET",
        "operationId": "listBackgroundJobs",
        "successData": "BackgroundJobListData",
        "security": ["BearerAuth"],
        "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN"]
      },
      "/background-jobs/{id}": {
        "method": "GET",
        "operationId": "getBackgroundJob",
        "successData": "BackgroundJob",
        "security": ["BearerAuth"],
        "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN", "BUSINESS_RESOURCE_NOT_FOUND"]
      },
      "/background-jobs/{id}:cancel": {
        "method": "POST",
        "operationId": "cancelBackgroundJob",
        "successData": "BackgroundJob",
        "security": ["BearerAuth"],
        "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN", "BUSINESS_RESOURCE_NOT_FOUND"]
      },
      "/background-jobs/{id}:retry": {
        "method": "POST",
        "operationId": "retryBackgroundJob",
        "successData": "BackgroundJob",
        "security": ["BearerAuth"],
        "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN", "BUSINESS_RESOURCE_NOT_FOUND", "BUSINESS_RULE_VIOLATION"]
      },
      "/knowledge-bases": {
        "method": "GET", "operationId": "listKnowledgeBases", "successData": "KnowledgeBaseListData",
        "security": ["BearerAuth"], "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN"]
      },
      "/knowledge-bases/{kb}/documents": {
        "method": "GET", "operationId": "listKnowledgeDocuments", "successData": "KnowledgeDocumentListData",
        "security": ["BearerAuth"], "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN"]
      },
      "/knowledge-bases/{kb}/documents/{document}": {
        "method": "GET", "operationId": "getKnowledgeDocument", "successData": "KnowledgeDocument",
        "security": ["BearerAuth"], "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN", "BUSINESS_RESOURCE_NOT_FOUND"]
      },
      "/knowledge-bases/{kb}/documents/{document}/chunk-preview": {
        "method": "GET", "operationId": "previewKnowledgeDocumentChunks", "successData": "ChunkPreviewData",
        "security": ["BearerAuth"], "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN", "BUSINESS_RESOURCE_NOT_FOUND"]
      },
      "/knowledge-bases/{kb}/documents/{document}/index-tasks": {
        "method": "POST", "operationId": "createDocumentIndexTask", "successData": "DocumentIndexTask",
        "security": ["BearerAuth"], "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN", "BUSINESS_RESOURCE_NOT_FOUND", "BUSINESS_CONFLICT"]
      },
      "/knowledge-bases/{kb}/documents/{document}/index-tasks/{task}": {
        "method": "GET", "operationId": "getDocumentIndexTask", "successData": "DocumentIndexTask",
        "security": ["BearerAuth"], "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN", "BUSINESS_RESOURCE_NOT_FOUND"]
      },
      "/knowledge-bases/{kb}/documents/{document}/index-tasks/{task}:retry": {
        "method": "POST", "operationId": "retryDocumentIndexTask", "successData": "DocumentIndexTask",
        "security": ["BearerAuth"], "errors": ["AUTH_REQUIRED", "AUTH_FORBIDDEN", "BUSINESS_RESOURCE_NOT_FOUND", "BUSINESS_RULE_VIOLATION"]
      }
    },
    "knowledgeOperations": [
      {"path":"/knowledge-bases","method":"GET","operationId":"listKnowledgeBases","successData":"KnowledgeBaseListData","security":["BearerAuth"],"errors":["AUTH_REQUIRED","AUTH_FORBIDDEN"]},
      {"path":"/knowledge-bases/{kb}/documents","method":"GET","operationId":"listKnowledgeDocuments","successData":"KnowledgeDocumentListData","security":["BearerAuth"],"errors":["AUTH_REQUIRED","AUTH_FORBIDDEN"]},
      {"path":"/knowledge-bases/{kb}/documents","method":"POST","operationId":"uploadKnowledgeDocument","successData":"KnowledgeDocument","security":["BearerAuth"],"errors":["AUTH_REQUIRED","AUTH_FORBIDDEN","BUSINESS_CONFLICT","VALIDATION_REQUEST_INVALID"]},
      {"path":"/knowledge-bases/{kb}/documents/{document}","method":"GET","operationId":"getKnowledgeDocument","successData":"KnowledgeDocument","security":["BearerAuth"],"errors":["AUTH_REQUIRED","AUTH_FORBIDDEN","BUSINESS_RESOURCE_NOT_FOUND"]},
      {"path":"/knowledge-bases/{kb}/documents/{document}","method":"DELETE","operationId":"deleteKnowledgeDocument","successData":"KnowledgeDocument","security":["BearerAuth"],"errors":["AUTH_REQUIRED","AUTH_FORBIDDEN","BUSINESS_RESOURCE_NOT_FOUND"]},
      {"path":"/knowledge-bases/{kb}/documents/{document}/chunk-preview","method":"GET","operationId":"previewKnowledgeDocumentChunks","successData":"ChunkPreviewData","security":["BearerAuth"],"errors":["AUTH_REQUIRED","AUTH_FORBIDDEN","BUSINESS_RESOURCE_NOT_FOUND"]}
    ],
    "documentIndexOperations": [
      {"path":"/knowledge-bases/{kb}/documents/{document}/index-tasks","method":"POST","operationId":"createDocumentIndexTask","successData":"DocumentIndexTask","security":["BearerAuth"],"errors":["AUTH_REQUIRED","AUTH_FORBIDDEN","BUSINESS_RESOURCE_NOT_FOUND","BUSINESS_CONFLICT"]},
      {"path":"/knowledge-bases/{kb}/documents/{document}/index-tasks/{task}","method":"GET","operationId":"getDocumentIndexTask","successData":"DocumentIndexTask","security":["BearerAuth"],"errors":["AUTH_REQUIRED","AUTH_FORBIDDEN","BUSINESS_RESOURCE_NOT_FOUND"]},
      {"path":"/knowledge-bases/{kb}/documents/{document}/index-tasks/{task}:retry","method":"POST","operationId":"retryDocumentIndexTask","successData":"DocumentIndexTask","security":["BearerAuth"],"errors":["AUTH_REQUIRED","AUTH_FORBIDDEN","BUSINESS_RESOURCE_NOT_FOUND","BUSINESS_RULE_VIOLATION"]}
    ],
    "chatOperations": [
      {"path":"/chat/sessions","method":"POST","operationId":"createChatSession","successData":"ChatSessionDetailData","security":["BearerAuth"],"errors":["AUTH_REQUIRED","AUTH_FORBIDDEN"]},
      {"path":"/chat/sessions","method":"GET","operationId":"listChatSessions","successData":"ChatSessionListData","security":["BearerAuth"],"errors":["AUTH_REQUIRED","AUTH_FORBIDDEN"]},
      {"path":"/chat/sessions/{id}","method":"GET","operationId":"getChatSession","successData":"ChatSessionDetailData","security":["BearerAuth"],"errors":["AUTH_REQUIRED","AUTH_FORBIDDEN"]},
      {"path":"/chat/sessions/{id}/messages","method":"POST","operationId":"appendChatMessage","successData":"ChatSessionDetailData","security":["BearerAuth"],"errors":["AUTH_REQUIRED","AUTH_FORBIDDEN","VALIDATION_REQUEST_INVALID"]},
      {"path":"/chat/sessions/{id}/messages:clear","method":"POST","operationId":"clearChatMessages","successData":"ChatSessionDetailData","security":["BearerAuth"],"errors":["AUTH_REQUIRED","AUTH_FORBIDDEN"]},
      {"path":"/chat/sessions/{id}","method":"DELETE","operationId":"deleteChatSession","successData":"ChatDeleteData","security":["BearerAuth"],"errors":["AUTH_REQUIRED","AUTH_FORBIDDEN"]}
    ]
  },
  "sse": {
    "eventTypes": [
      "content.delta",
      "reasoning.delta",
      "tool.call",
      "reference.source",
      "task.status",
      "report",
      "complete",
      "error"
    ],
    "toolCallLifecycles": ["started", "delta", "completed", "failed"]
  }
}
